.DS_Store
_to_delete/
.Rhistory
.Rproj.user/
Rplots.pdf
_wip_backup/

# R session temp
scripts/.RDataTmp

# ---- renv -------------------------------------------------------------------
# renv.lock, renv/activate.R and renv/settings.json ARE tracked: together they
# are the environment pin, and `renv::restore()` needs nothing else.
# Everything below is machine-specific and is regenerated by the restore.
renv/library/
renv/staging/
renv/local/
renv/sandbox/
renv/python/
renv/cellar/

# ---- logs -------------------------------------------------------------------
# scripts/run_all.sh writes a timestamped tree here on every run. The directory
# is kept, its contents are not.
logs/*
!logs/.gitkeep

# ---- LaTeX build artefacts --------------------------------------------------
# Scoped to reports/ ON PURPOSE. A bare `*.log` would also swallow the pipeline
# logs under logs/, which are real output worth being able to commit.
reports/**/*.aux
reports/**/*.log
reports/**/*.toc
reports/**/*.out
reports/**/*.tex
